{
    "name": "municipality/portal",
    "description": "Municipality Portal Application",
    "type": "project",
    "license": "MIT",

    "require": {
        "php": "^8.2",
        "cviebrock/eloquent-sluggable": "^11.0",
        "intervention/image": "^3.0",
        "laravel/breeze": "^2.1",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "spatie/laravel-permission": "^6.0"
    },

    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5|^11.0",
        "laravel/telescope": "^5.0"
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },

    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },

    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin-laravel": true
        },
        "audit": {
            "abandoned": "ignore",
            "block-insecure": false,
            "ignore": [
                "PKSA-m5cs-t1y6-qpcs",
                "PKSA-3r5d-mb8f-1qw9",
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-8qx3-n5y5-vvnd",
                "PKSA-q46n-4fdk-zjr4",
                "PKSA-qzrn-rnz3-85w1",
                "PKSA-w7xr-vk7n-rstm",
                "PKSA-p3rx-dfwp-73ny",
                "PKSA-ckwp-rt7t-c46m",
                "PKSA-njrm-6dtg-m2pc"
            ]
        }
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}
